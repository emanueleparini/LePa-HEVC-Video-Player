<Window x:Class="HevcPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="LePa HEVC Player" Icon="Assets/app.ico" Height="640" Width="1080" MinHeight="360" MinWidth="640"
        Background="{StaticResource WindowBg}" FontFamily="{StaticResource UiFont}"
        AllowDrop="True" WindowStartupLocation="CenterScreen"
        SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded" Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown" Drop="Window_Drop">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Menu bar ===== -->
        <Border x:Name="MenuBar" Grid.Row="0" Background="{StaticResource BarBg}" Padding="4,2"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Menu>
                <MenuItem Header="_File">
                    <MenuItem Header="Open file…" InputGestureText="Ctrl+O" Click="Open_Click"/>
                    <MenuItem Header="Open folder…" InputGestureText="Ctrl+Shift+O" Click="OpenFolder_Click"/>
                    <MenuItem Header="Open URL / stream…" InputGestureText="Ctrl+U" Click="OpenUrl_Click"/>
                    <MenuItem x:Name="RecentMenu" Header="Recent files" SubmenuOpened="RecentMenu_SubmenuOpened">
                        <MenuItem Header="(empty)" IsEnabled="False"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Close file" InputGestureText="Ctrl+W" Click="CloseFile_Click"/>
                    <MenuItem Header="Exit" InputGestureText="Alt+F4" Click="Exit_Click"/>
                </MenuItem>
                <MenuItem Header="_Playback" SubmenuOpened="PlaybackMenu_SubmenuOpened">
                    <MenuItem x:Name="MenuPlayPause" Header="Play" InputGestureText="Space" Click="PlayPause_Click"/>
                    <MenuItem Header="Stop" InputGestureText="S" Click="Stop_Click"/>
                    <Separator/>
                    <MenuItem Header="Back 10 s" InputGestureText="J" Click="Back10_Click"/>
                    <MenuItem Header="Forward 30 s" InputGestureText="L" Click="Forward30_Click"/>
                    <MenuItem Header="Back 1 min" InputGestureText="Ctrl+←" Click="Back60_Click"/>
                    <MenuItem Header="Forward 1 min" InputGestureText="Ctrl+→" Click="Forward60_Click"/>
                    <MenuItem Header="Next frame" InputGestureText="." Click="NextFrame_Click"/>
                    <Separator/>
                    <MenuItem Header="Previous file" InputGestureText="PgUp" Click="Prev_Click"/>
                    <MenuItem Header="Next file" InputGestureText="PgDn" Click="Next_Click"/>
                    <Separator/>
                    <MenuItem x:Name="SpeedMenu" Header="Speed"/>
                    <MenuItem x:Name="MenuRepeat" Header="Repeat file" InputGestureText="R" IsCheckable="True" Click="Repeat_Click"/>
                    <MenuItem x:Name="MenuAutoNext" Header="Play next file automatically" IsCheckable="True" IsChecked="True"/>
                </MenuItem>
                <MenuItem Header="_Audio">
                    <MenuItem x:Name="AudioTrackMenu" Header="Audio track" SubmenuOpened="AudioTrackMenu_SubmenuOpened">
                        <MenuItem Header="(none)" IsEnabled="False"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Volume up" InputGestureText="↑" Click="VolumeUp_Click"/>
                    <MenuItem Header="Volume down" InputGestureText="↓" Click="VolumeDown_Click"/>
                    <MenuItem x:Name="MenuMute" Header="Mute" InputGestureText="M" IsCheckable="True" Click="Mute_Click"/>
                </MenuItem>
                <MenuItem Header="_Video">
                    <MenuItem Header="Fullscreen" InputGestureText="F" Click="Fullscreen_Click"/>
                    <MenuItem x:Name="AspectMenu" Header="Aspect ratio"/>
                    <MenuItem x:Name="MenuTopmost" Header="Always on top" InputGestureText="T" IsCheckable="True" Click="Topmost_Click"/>
                    <Separator/>
                    <MenuItem Header="Screenshot" InputGestureText="Ctrl+S" Click="Snapshot_Click"/>
                    <MenuItem Header="Open screenshots folder" Click="OpenSnapshotFolder_Click"/>
                    <Separator/>
                    <MenuItem Header="Media information" InputGestureText="I" Click="MediaInfo_Click"/>
                </MenuItem>
                <MenuItem Header="_Subtitles">
                    <MenuItem x:Name="SubtitleTrackMenu" Header="Subtitle track" SubmenuOpened="SubtitleTrackMenu_SubmenuOpened">
                        <MenuItem Header="(none)" IsEnabled="False"/>
                    </MenuItem>
                    <MenuItem Header="Load subtitle file…" Click="LoadSubtitle_Click"/>
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="Keyboard shortcuts" InputGestureText="F1" Click="Shortcuts_Click"/>
                    <MenuItem Header="About LePa HEVC Player" Click="About_Click"/>
                </MenuItem>
            </Menu>
        </Border>

        <!-- ===== Video ===== -->
        <vlc:VideoView x:Name="VideoView" Grid.Row="1">
            <!-- Near-transparent overlay: lives above the native video surface and receives mouse/drag input -->
            <Grid x:Name="Overlay" Background="#01000000" AllowDrop="True"
                  Loaded="Overlay_Loaded"
                  MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
                  MouseRightButtonUp="Overlay_MouseRightButtonUp"
                  MouseWheel="Overlay_MouseWheel"
                  MouseMove="Overlay_MouseMove"
                  Drop="Window_Drop">

                <!-- Empty state -->
                <StackPanel x:Name="Placeholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="Assets/logo-symbol.png" Width="88" Height="88" HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="No video open" Foreground="{StaticResource TextPrimary}" FontSize="20"
                               FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,4"/>
                    <TextBlock x:Name="PlaceholderHint" Text="Drop a file here or open one from the File menu" Foreground="{StaticResource TextSecondary}"
                               FontSize="13" HorizontalAlignment="Center"/>
                    <Button Style="{StaticResource AccentPillButton}" Content="Open file" Margin="0,22,0,0"
                            HorizontalAlignment="Center" Click="Open_Click"/>
                    <TextBlock Text="MP4 · MKV · MOV · TS — HEVC, H.264, AV1, VP9" Foreground="{StaticResource TextDisabled}"
                               FontSize="11" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>

                <!-- On-screen notification -->
                <Border x:Name="Osd" Background="#CC16161A" CornerRadius="16" Padding="14,6"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                        Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="OsdText" Foreground="White" FontSize="14"/>
                </Border>
            </Grid>
        </vlc:VideoView>

        <!-- ===== Control bar (moved over the video in fullscreen) ===== -->
        <Border x:Name="ControlBar" Grid.Row="2" Background="{StaticResource BarBg}" Padding="16,6,16,8">
            <StackPanel>
                <Grid>
                    <Slider x:Name="SeekSlider" Minimum="0" Maximum="1"
                            ValueChanged="SeekSlider_ValueChanged"
                            MouseMove="SeekSlider_MouseMove" MouseLeave="SeekSlider_MouseLeave"/>
                    <Popup x:Name="SeekPreview" PlacementTarget="{Binding ElementName=SeekSlider}" Placement="Top"
                           AllowsTransparency="True" IsHitTestVisible="False" VerticalOffset="-4">
                        <Border Background="{StaticResource SurfaceBg}" CornerRadius="5" Padding="7,3"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <TextBlock x:Name="SeekPreviewText" Foreground="{StaticResource TextPrimary}" FontSize="12"/>
                        </Border>
                    </Popup>
                </Grid>

                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: time + info -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TimeText" Foreground="{StaticResource TextPrimary}" FontSize="13"
                                   Text="00:00" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LengthText" Foreground="{StaticResource TextSecondary}" FontSize="13"
                                   Text=" / 00:00" VerticalAlignment="Center" Cursor="Hand"
                                   ToolTip="Click: remaining time / duration" MouseLeftButtonUp="LengthText_Click"/>
                        <Border x:Name="InfoChip" Background="#24242C" CornerRadius="4" Padding="6,2" Margin="12,0,0,0"
                                VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock x:Name="InfoText" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Center: transport -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Content="&#xE892;"
                                ToolTip="Previous file (PgUp)" Click="Prev_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xED3C;" FontSize="18"
                                ToolTip="Back 10 s (J)" Click="Back10_Click"/>
                        <Button x:Name="PlayPauseButton" Style="{StaticResource PlayButton}" Content="&#xE768;"
                                ToolTip="Play / Pause (Space)" Click="PlayPause_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xED3D;" FontSize="18"
                                ToolTip="Forward 30 s (L)" Click="Forward30_Click"/>
                        <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;"
                                ToolTip="Next file (PgDn)" Click="Next_Click"/>
                    </StackPanel>

                    <!-- Right: utilities -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="SpeedButton" Style="{StaticResource PillButton}" Content="1×"
                                ToolTip="Playback speed" Click="SpeedButton_Click"/>
                        <ToggleButton x:Name="RepeatToggle" Style="{StaticResource IconToggleButton}" Content="&#xE8ED;"
                                      ToolTip="Repeat file (R)" Click="RepeatButton_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xED1E;"
                                ToolTip="Subtitles" Click="SubtitlesButton_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE8D6;"
                                ToolTip="Audio track" Click="AudioButton_Click"/>
                        <Button x:Name="MuteButton" Style="{StaticResource IconButton}" Content="&#xE995;"
                                ToolTip="Mute (M)" Click="Mute_Click" Margin="6,0,0,0"/>
                        <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="100" Value="80"
                                VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                        <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Content="&#xE740;"
                                ToolTip="Fullscreen (F)" Click="Fullscreen_Click" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
